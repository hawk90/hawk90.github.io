{
  "name": "astro-hawk-blog",
  "type": "module",
  "version": "1.0.0",
  "description": "A premium Astro blog theme with dark mode, search, series, SEO, analytics, comments, and i18n support",
  "keywords": [
    "astro",
    "blog",
    "theme",
    "tailwindcss",
    "dark-mode",
    "seo",
    "search",
    "giscus",
    "analytics",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hawk90/hawk90.github.io"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-og.mjs --prune",
    "build": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=8192} astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test:search": "node scripts/verify-search.mjs",
    "test:topics": "node scripts/verify-topic-registry.mjs",
    "test:classification": "node scripts/verify-content-classification.mjs",
    "test:relations": "node scripts/verify-content-relations.mjs",
    "sync:book-notes": "node scripts/sync-book-notes.mjs",
    "archive:chatgpt": "node scripts/archive-chatgpt-share.mjs",
    "build:llm-antipatterns": "node scripts/build-llm-antipatterns.mjs",
    "build:llm-phases": "node scripts/build-llm-phases.mjs",
    "scaffold:claude-phases": "node scripts/scaffold-claude-phases.mjs",
    "plan:remediation": "node scripts/plan-remediation.mjs",
    "audit:antipatterns": "node scripts/audit-antipatterns.mjs",
    "audit:classification": "node scripts/audit-content-classification.mjs",
    "audit:content-readiness": "node scripts/audit-content-readiness.mjs",
    "audit:remediation-graph": "node scripts/audit-remediation-graph.mjs",
    "build:methodology-registry": "node scripts/build-methodology-registry.mjs",
    "plan:methodology-batches": "node scripts/plan-methodology-batches.mjs",
    "record:methodology-controls": "node scripts/record-methodology-controls.mjs",
    "route:methodology-search": "node scripts/route-methodology-search-proposals.mjs",
    "build:category-registry": "node scripts/build-category-registry.mjs",
    "audit:category-registry": "node scripts/audit-category-registry.mjs",
    "plan:category-batches": "node scripts/plan-category-batches.mjs",
    "audit:methodology": "node scripts/audit-methodology-registry.mjs",
    "audit:methodology-policy": "node scripts/audit-remediation-evidence-policy.mjs",
    "audit:priority-policy": "node scripts/audit-priority-decision-policy.mjs",
    "audit:change-automation-policy": "node scripts/audit-change-automation-policy.mjs",
    "audit:governance-lifecycle-policy": "node scripts/audit-governance-lifecycle-policy.mjs",
    "audit:knowledge-model": "node scripts/audit-knowledge-model.mjs",
    "audit:lifecycle": "node scripts/audit-content-lifecycle.mjs",
    "audit:product-experience": "node scripts/audit-product-experience.mjs",
    "build:governance-queue": "node scripts/build-content-governance-queue.mjs",
    "gate:classification": "node scripts/audit-content-classification.mjs --enforce",
    "migrate:topics": "node scripts/migrate-explicit-topics.mjs",
    "audit:security-admin": "node scripts/security-admin-gate.mjs",
    "gate:security-admin": "node scripts/security-admin-gate.mjs --enforce",
    "audit:secrets": "node scripts/scan-secrets.mjs",
    "gate:secrets": "node scripts/scan-secrets.mjs --enforce",
    "gate:dependencies": "npm audit --omit=dev --audit-level=high",
    "gate:ci-security": "node scripts/audit-ci-security.mjs",
    "gate:repository": "node scripts/audit-repository-health.mjs",
    "audit:repository-resilience": "node scripts/audit-repository-resilience.mjs",
    "record:repository-controls": "node scripts/record-repository-controls.mjs",
    "audit:repository-controls": "node scripts/audit-repository-controls.mjs",
    "record:repository-external-evidence": "node scripts/record-repository-external-evidence.mjs",
    "audit:repository-external-evidence": "node scripts/audit-repository-external-evidence.mjs",
    "audit:content-portability": "node scripts/audit-content-portability.mjs",
    "audit:content-asset-portability": "node scripts/audit-content-asset-portability.mjs",
    "audit:frontmatter-portability": "node scripts/audit-frontmatter-portability.mjs",
    "build:source-inventory": "node scripts/build-source-inventory.mjs",
    "exercise:local-recovery": "node scripts/exercise-local-recovery.mjs",
    "export:portable-content": "node scripts/export-portable-content.mjs",
    "audit:portable-content-export": "node scripts/audit-portable-content-export.mjs",
    "plan:repository-open-controls": "node scripts/plan-repository-open-controls.mjs",
    "defer:repository-external-controls": "node scripts/defer-repository-external-controls.mjs",
    "authorize:deferred-repository-activation": "node scripts/authorize-deferred-repository-activation.mjs",
    "record:quality-controls": "node scripts/record-quality-controls.mjs",
    "audit:quality-controls": "node scripts/audit-quality-controls.mjs",
    "audit:anchors": "node scripts/audit-anchor-links.mjs",
    "audit:search-page-parity": "node scripts/audit-search-page-parity.mjs",
    "audit:quality-contracts": "node scripts/audit-quality-contracts.mjs",
    "audit:distribution-feeds": "node scripts/audit-distribution-feeds.mjs",
    "audit:diagrams": "node scripts/audit-diagram-assets.mjs",
    "review:diagrams": "node scripts/build-diagram-review-index.mjs",
    "audit:diagram-quality": "node scripts/audit-diagram-quality.mjs",
    "audit:tooling": "node scripts/audit-tooling.mjs",
    "gate:tooling": "node scripts/audit-tooling.mjs --enforce",
    "verify:release": "node scripts/verify-release.mjs",
    "review:semantic-merges": "node scripts/prepare-semantic-merge-review.mjs",
    "og": "node scripts/build-og.mjs",
    "og:force": "node scripts/build-og.mjs --force",
    "og:prune": "node scripts/build-og.mjs --prune",
    "diagrams": "bash scripts/build-diagrams.sh",
    "diagrams:force": "bash scripts/build-diagrams.sh --force",
    "diagrams:watch": "bash scripts/watch-diagrams.sh",
    "audit:gate": "bash scripts/audit-publish-gate.sh",
    "audit:upstream": "python3 scripts/audit-upstream-freshness.py --top 20",
    "audit:upstream:json": "python3 scripts/audit-upstream-freshness.py --top 50 --json reports/upstream-freshness.json",
    "audit:links": "python3 scripts/audit-internal-links.py",
    "audit:links:fix": "python3 scripts/resolve-internal-links.py --apply",
    "audit:series": "python3 scripts/audit-series-integrity.py",
    "audit:images": "python3 scripts/audit-image-coverage.py --top 30",
    "audit:roadmap": "python3 scripts/audit-roadmap-staleness.py",
    "audit:staleness": "python3 scripts/audit-prose-staleness.py",
    "audit:tone": "python3 scripts/audit-tone-consistency.py",
    "check:duplicate": "python3 scripts/check-duplicate-topic.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@milkdown/kit": "^7.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^7.1.6",
    "astro-expressive-code": "^0.44.1",
    "cheerio": "^1.2.0",
    "marked": "^18.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.18.3",
    "satori-html": "^0.3.2",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
