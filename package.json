{
  "name": "astro-hawk-blog",
  "type": "module",
  "version": "1.0.0",
  "description": "A premium Astro blog theme with dark mode, search, series, SEO, analytics, comments, and i18n support",
  "keywords": [
    "astro",
    "blog",
    "theme",
    "tailwindcss",
    "dark-mode",
    "seo",
    "search",
    "giscus",
    "analytics",
    "i18n"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hawk90/hawk90.github.io"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-og.mjs --prune",
    "build": "NODE_OPTIONS=${NODE_OPTIONS:---max-old-space-size=8192} astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "sync:book-notes": "node scripts/sync-book-notes.mjs",
    "archive:chatgpt": "node scripts/archive-chatgpt-share.mjs",
    "build:llm-antipatterns": "node scripts/build-llm-antipatterns.mjs",
    "build:llm-phases": "node scripts/build-llm-phases.mjs",
    "scaffold:claude-phases": "node scripts/scaffold-claude-phases.mjs",
    "plan:remediation": "node scripts/plan-remediation.mjs",
    "audit:antipatterns": "node scripts/audit-antipatterns.mjs",
    "audit:security-admin": "node scripts/security-admin-gate.mjs",
    "gate:security-admin": "node scripts/security-admin-gate.mjs --enforce",
    "review:semantic-merges": "node scripts/prepare-semantic-merge-review.mjs",
    "og": "node scripts/build-og.mjs",
    "og:force": "node scripts/build-og.mjs --force",
    "og:prune": "node scripts/build-og.mjs --prune",
    "diagrams": "bash scripts/build-diagrams.sh",
    "diagrams:force": "bash scripts/build-diagrams.sh --force",
    "diagrams:watch": "bash scripts/watch-diagrams.sh",
    "audit:gate": "bash scripts/audit-publish-gate.sh",
    "audit:upstream": "python3 scripts/audit-upstream-freshness.py --top 20",
    "audit:upstream:json": "python3 scripts/audit-upstream-freshness.py --top 50 --json reports/upstream-freshness.json",
    "audit:links": "python3 scripts/audit-internal-links.py",
    "audit:links:fix": "python3 scripts/resolve-internal-links.py --apply",
    "audit:series": "python3 scripts/audit-series-integrity.py",
    "audit:images": "python3 scripts/audit-image-coverage.py --top 30",
    "audit:roadmap": "python3 scripts/audit-roadmap-staleness.py",
    "audit:staleness": "python3 scripts/audit-prose-staleness.py",
    "audit:tone": "python3 scripts/audit-tone-consistency.py",
    "check:duplicate": "python3 scripts/check-duplicate-topic.py"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.1",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@expressive-code/plugin-line-numbers": "^0.42.0",
    "@milkdown/kit": "^7.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^6.0.5",
    "astro-expressive-code": "^0.42.0",
    "cheerio": "^1.2.0",
    "marked": "^18.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.18.3",
    "satori-html": "^0.3.2",
    "tailwindcss": "^4.1.18",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3"
  }
}
