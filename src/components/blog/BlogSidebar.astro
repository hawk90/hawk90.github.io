---
import CategoryTreeNode, { type CategoryTreeNodeData } from './CategoryTreeNode.astro';
import TagBadge from './TagBadge.astro';
import { CATEGORIES, getTopLevelCategories, getSubCategories } from '../../consts/categories';
import { BLOG_CONFIG } from '../../consts/config';
import { getTagsWithCount, getRoutableTagKeys, categoryIdsOf, type BlogPost } from '../../lib/posts';
import { toSlug, getTagUrl } from '../../lib/utils';

interface Props {
  posts: BlogPost[];
  activeFilter?: {
    type: 'tag' | 'series' | 'category';
    value: string;
  };
}

const { activeFilter, posts: allPosts } = Astro.props;
const sortedTags = getTagsWithCount(allPosts);
// Only tags with a page may be rendered as links (see getRoutableTagKeys).
const routableTags = await getRoutableTagKeys();
const { maxTagsInSidebar } = BLOG_CONFIG;

const topCats = getTopLevelCategories();
const categoryById = new Map(CATEGORIES.map((category) => [category.id, category]));
const childrenByParent = new Map(CATEGORIES.map((category) => [category.id, getSubCategories(category.id)]));
const subCategoryIdsByParent = new Map(
  [...childrenByParent.entries()].map(([id, children]) => [id, children.map((sub) => sub.id)]),
);
// Bucketed by declared topic, not by slicing the post id. The id is the frozen
// URL, so splitting it on '/' made the tree a picture of the folder layout.
const postsByCategory = new Map(CATEGORIES.map((category) => [category.id, [] as BlogPost[]]));
for (const post of allPosts) {
  for (const categoryId of categoryIdsOf(post)) postsByCategory.get(categoryId)?.push(post);
}

interface SeriesLink {
  name: string;
  slug: string;
  count: number;
  isActive: boolean;
}

function isActiveTag(tag: string): boolean {
  return activeFilter?.type === 'tag' && activeFilter.value.toLowerCase() === tag.toLowerCase();
}

function isActiveSeries(series: string): boolean {
  return activeFilter?.type === 'series' && activeFilter.value === series;
}

function isActiveCategory(categoryId: string): boolean {
  return activeFilter?.type === 'category' && activeFilter.value === categoryId;
}

function postsDirectlyIn(catId: string) {
  const subCatIds = subCategoryIdsByParent.get(catId) ?? [];
  return (postsByCategory.get(catId) ?? []).filter((post) => {
    const ids = categoryIdsOf(post);
    return !subCatIds.some((sub) => ids.has(sub));
  });
}

function buildSeriesLinks(posts: typeof allPosts): SeriesLink[] {
  const counts = new Map<string, number>();
  posts.forEach((post) => {
    if (!post.data.series) return;
    counts.set(post.data.series, (counts.get(post.data.series) ?? 0) + 1);
  });
  return [...counts.entries()].map(([series, count]) => ({
    name: series,
    slug: toSlug(series),
    count,
    isActive: isActiveSeries(series),
  }));
}

/**
 * Whether a category has anything published under it, itself or below.
 *
 * The tree used to render all 65 registry entries, 54 of which had no published
 * post — and the count badge is hidden at zero (CategoryTreeNode), so an empty
 * branch looked exactly like an unexpanded one until the click. Those pages are
 * no longer built either, so linking them here would also be a 404.
 */
function hasPublished(categoryId: string): boolean {
  return (postsByCategory.get(categoryId) ?? []).length > 0;
}

function buildCategoryNode(categoryId: string): CategoryTreeNodeData {
  const category = categoryById.get(categoryId);
  if (!category) {
    throw new Error(`Unknown category: ${categoryId}`);
  }

  const children = (childrenByParent.get(category.id) ?? [])
    .filter((child) => hasPublished(child.id))
    .map((child) => buildCategoryNode(child.id));
  const directPosts = postsDirectlyIn(category.id);
  const hasActiveDescendant = children.some((child) => child.isActive || child.initiallyOpen);

  return {
    id: category.id,
    name: category.name,
    icon: category.icon ?? '',
    count: (postsByCategory.get(category.id) ?? []).length,
    isActive: isActiveCategory(category.id),
    initiallyOpen: isActiveCategory(category.id) || hasActiveDescendant,
    children,
    series: buildSeriesLinks(directPosts),
  };
}

const categoryTree = topCats.filter((category) => hasPublished(category.id)).map((category) => buildCategoryNode(category.id));
---

<aside class="hidden lg:block w-72 shrink-0">
  <div class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-1">
    <div class="space-y-5">
      <a
        href="/blog"
        data-astro-prefetch="viewport"
        class:list={[
          'inline-flex items-center gap-2 text-sm font-medium transition-colors',
          !activeFilter
            ? 'text-[var(--color-accent)]'
            : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
        ]}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0l-4-4m4 4l-4 4" />
        </svg>
        All Posts
      </a>

      <div class="sidebar-divider">
        <div class="flex items-center justify-between mb-3">
          {/* h2, not h3: the sidebar is a sibling of the main content, not a
              subsection of it, and on an empty category no h2 precedes it. */}
          <h2 class="sidebar-section-title">Browse</h2>
          <div class="flex gap-1">
            <button
              type="button"
              data-tree-expand-all
              class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] px-1 py-1 transition-colors"
              title="Expand all"
            >Expand</button>
            <button
              type="button"
              data-tree-collapse-all
              class="text-xs text-[var(--color-text-muted)] hover:text-[var(--color-accent)] px-1 py-1 transition-colors"
              title="Collapse all"
            >Collapse</button>
          </div>
        </div>
        <nav class="space-y-1">
          {categoryTree.map((node) => (
            <CategoryTreeNode node={node} />
          ))}
        </nav>
      </div>

      <div class="sidebar-divider">
        <h2 class="sidebar-section-title mb-3">Tags</h2>
        <div class="flex flex-wrap gap-2">
          {sortedTags.slice(0, maxTagsInSidebar).filter(([tag]) => routableTags.has(tag.toLocaleLowerCase())).map(([tag]) => {
            const isTagActive = isActiveTag(tag);
            return (
              <a
                href={getTagUrl(tag)}
                data-astro-prefetch="viewport"
                class:list={[
                  isTagActive && 'ring-2 ring-[var(--color-accent)] ring-offset-2 ring-offset-[var(--color-bg-primary)] rounded-full',
                ]}
              >
                <TagBadge tag={tag} />
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</aside>

<style>
  .cat-tree > :not(:first-child) {
    margin-top: 0.25rem;
  }

  /* Hide native disclosure marker — chevron button replaces it */
  .cat-row { list-style: none; cursor: default; }
  .cat-row::-webkit-details-marker { display: none; }
  .cat-row::marker { display: none; }

  .cat-tree[open] .cat-toggle > .chevron {
    transform: rotate(90deg);
  }
</style>

<script>
  import { onPageLoad } from '../../lib/lifecycle';

  /**
   * Which branches the reader has open, for as long as the tab is open.
   *
   * The tree's open state is rendered per page from the post being viewed, so
   * every navigation used to rebuild it as "only the branch containing this
   * page". Expanding a branch to look around, then clicking anything, closed
   * it again — from the reader's side, opening one place closed another. The
   * nodes were never wired to each other; the whole tree was simply reset on
   * every page.
   *
   * sessionStorage, not localStorage: this is where the reader is in one
   * browsing session, not a setting they chose.
   */
  const STORAGE_KEY = 'blog-sidebar-open';

  const readStored = (): Set<string> | null => {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      return raw ? new Set(JSON.parse(raw) as string[]) : null;
    } catch {
      // Private mode and disabled storage both throw. The tree still works;
      // it just forgets, which is the behaviour it had before.
      return null;
    }
  };

  const writeStored = (open: Set<string>) => {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify([...open]));
    } catch { /* see readStored */ }
  };

  onPageLoad(() => {
    const nodes = [...document.querySelectorAll<HTMLDetailsElement>('.cat-tree')];
    if (!nodes.length) return;

    const idOf = (details: HTMLDetailsElement) => details.dataset.category ?? '';
    const syncAria = (details: HTMLDetailsElement) => {
      details.querySelector<HTMLButtonElement>('.cat-toggle')?.setAttribute('aria-expanded', String(details.open));
    };

    // Read before touching anything: this is the server's answer, i.e. the
    // trail down to the page being viewed.
    const activeTrail = new Set(nodes.filter((details) => details.open).map(idOf));

    let restoring = false;
    const persist = () => {
      if (restoring) return;
      writeStored(new Set(nodes.filter((details) => details.open).map(idOf)));
    };

    const stored = readStored();
    if (stored) {
      // The reader's branches, plus the trail to where they are now — so the
      // current page is always visible without reopening what they collapsed.
      restoring = true;
      for (const details of nodes) {
        details.open = stored.has(idOf(details)) || activeTrail.has(idOf(details));
        syncAria(details);
      }
      restoring = false;
    }
    // Deliberately not seeded here. With nothing stored the tree behaves
    // exactly as it did before — the server's shape — and only starts
    // remembering once the reader actually opens or closes something.

    const applyAll = (open: boolean) => {
      for (const details of nodes) {
        details.open = open;
        syncAria(details);
      }
      persist();
    };

    const cleanups: Array<() => void> = [];

    // The `toggle` event fires however the branch was opened — the chevron, the
    // summary itself, or find-in-page. Listening here rather than on the button
    // is what keeps the stored state and the DOM from drifting apart.
    for (const details of nodes) {
      const onToggle = () => { syncAria(details); persist(); };
      details.addEventListener('toggle', onToggle);
      cleanups.push(() => details.removeEventListener('toggle', onToggle));
    }

    document.querySelectorAll<HTMLButtonElement>('.cat-toggle').forEach((button) => {
      const onClick = (e: MouseEvent) => {
        e.preventDefault();
        e.stopPropagation();
        const details = button.closest<HTMLDetailsElement>('.cat-tree');
        if (!details) return;
        details.open = !details.open;
      };
      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });

    // Prevent navigation links inside <summary> from also toggling the details
    document.querySelectorAll<HTMLAnchorElement>('.cat-row a').forEach((link) => {
      const onClick = (e: MouseEvent) => {
        e.stopPropagation();
      };
      link.addEventListener('click', onClick);
      cleanups.push(() => link.removeEventListener('click', onClick));
    });

    document.querySelectorAll<HTMLElement>('[data-tree-expand-all]').forEach((button) => {
      const onClick = () => applyAll(true);
      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });

    document.querySelectorAll<HTMLElement>('[data-tree-collapse-all]').forEach((button) => {
      const onClick = () => applyAll(false);
      button.addEventListener('click', onClick);
      cleanups.push(() => button.removeEventListener('click', onClick));
    });

    return () => cleanups.forEach((cleanup) => cleanup());
  });
</script>
