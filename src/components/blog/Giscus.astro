---
/**
 * giscus comments, without running giscus's client.js on this origin.
 *
 * client.js (giscus/giscus client.ts @ e61d28ac, 2025-04-14) only builds an
 * iframe pointing at giscus.app and relays postMessage. Loading it from
 * giscus.app would run third-party code with this site's privileges and no
 * integrity check (it changes too often for SRI). The loader below does the
 * same job in-repo; the comments themselves still render inside giscus.app's
 * cross-origin iframe, which cannot touch this page.
 *
 * Kept identical to client.ts where it matters for compatibility: the
 * `giscus-session` localStorage key, the `?giscus=` session handoff, the
 * pathname-term formula, and the widget query parameters. Deliberate
 * differences: the term and origin use the canonical path (see canonicalPath),
 * and query strings/anchors are not sent. If giscus changes its widget
 * protocol, diff client.ts against that commit and port the change here.
 */
import { COMMENTS_CONFIG, SITE_CONFIG } from '../../consts/config';
import { t } from '../../consts/ui-strings';

const giscusConfig = COMMENTS_CONFIG.enabled && COMMENTS_CONFIG.provider === 'giscus'
  ? COMMENTS_CONFIG
  : null;

const config = giscusConfig && {
  repo: giscusConfig.repo,
  repoId: giscusConfig.repoId,
  category: giscusConfig.category,
  categoryId: giscusConfig.categoryId,
  lang: giscusConfig.lang,
};

const setupMessage = t('giscus_setup_required');
const setupLink = t('giscus_setup_link');
const frameTitle = t('giscus_frame_title');
const siteOrigin = new URL(SITE_CONFIG.url).origin;
---

{config && (
  <>
  {/* Open the connection early; the widget itself loads near the comments. */}
  <link rel="preconnect" href="https://giscus.app" />
  <div
    class="giscus-wrapper"
    data-giscus-repo={config.repo}
    data-giscus-repo-id={config.repoId}
    data-giscus-category={config.category}
    data-giscus-category-id={config.categoryId}
    data-giscus-lang={config.lang}
    data-giscus-title={frameTitle}
    data-giscus-site={siteOrigin}
  >
    <div class="giscus"></div>
    <div class="giscus-error hidden p-4 text-center text-sm text-[var(--color-text-muted)] border border-[var(--color-border)] rounded-lg">
      <p>{setupMessage}</p>
      <a href="https://giscus.app" target="_blank" rel="noopener noreferrer" class="text-[var(--color-accent)] hover:underline">
        {setupLink}
      </a>
    </div>
  </div>
  </>
)}

<style is:global>
  /* giscus.app/default.css, served from here instead of giscus.app */
  .giscus,
  .giscus-frame {
    width: 100%;
    min-height: 150px;
  }
  .giscus-frame {
    border: none;
    color-scheme: light dark;
  }
  .giscus-frame--loading {
    opacity: 0;
  }
</style>

<script>
  import { onPageLoad } from '../../lib/lifecycle';

  const GISCUS_ORIGIN = 'https://giscus.app';
  const SESSION_KEY = 'giscus-session';
  // giscus sessions are a 96-bit IV in hex followed by base64 AES-GCM
  // ciphertext (giscus lib/oauth/encryption.ts). Anything else is not a
  // session and is neither stored nor sent.
  const SESSION_FORMAT = /^[0-9a-f]{24}[A-Za-z0-9+/]+={0,2}$/;
  const SESSION_MAX_LENGTH = 4096;
  // Upper bound for the height the widget may ask for.
  const MAX_FRAME_HEIGHT = 100_000;
  // Start loading this far before the comments scroll into view. giscus needs
  // ~2 s (widget page, then the discussions API, back to back), so begin about
  // two screens early and the reader rarely sees the spinner.
  const PRELOAD_MARGIN = '1500px 0px';

  // Widget options that are the same on every page.
  const FIXED_PARAMS = {
    reactionsEnabled: '1',
    emitMetadata: '0',
    inputPosition: 'top',
    // Hash match instead of GitHub's fuzzy title search, so posts with similar
    // paths never share a thread.
    strict: '1',
  };

  function currentTheme(): string {
    return document.documentElement.classList.contains('light') ? 'light' : 'dark_dimmed';
  }

  function metaContent(selector: string): string {
    return document.querySelector<HTMLMetaElement>(selector)?.content ?? '';
  }

  function isSession(value: unknown): value is string {
    return typeof value === 'string' && value.length <= SESSION_MAX_LENGTH && SESSION_FORMAT.test(value);
  }

  function forgetSession() {
    try {
      localStorage.removeItem(SESSION_KEY);
    } catch {
      // Storage blocked (private mode, site data off): nothing was stored.
    }
  }

  /**
   * After GitHub login, giscus.app sends the reader back with ?giscus=<session>.
   * Keep it (same key client.js uses) and take it out of the address bar.
   *
   * Accepted risk — session fixation: a crafted link can carry someone
   * else's valid session, so the reader would comment as that account. The
   * attacker gains nothing of the reader's (it is their own token), and the
   * widget shows the signed-in name and avatar. Restricting by
   * document.referrer (github.com / giscus.app) was considered and rejected:
   * browsers and extensions that strip referrers would break real logins.
   * Revisit if giscus adds a login nonce, or if impersonation is reported.
   * The serious direction is stealing a reader's 1-year session. On pages
   * with the strict CSP, script hashes and the absence of third-party script
   * guard it. Pages with ads run adsbygoogle.js in this origin under the ads
   * CSP, and that code can read localStorage; the pre-ads scrubber in
   * BaseLayout only keeps the token out of the URL the ad request reports.
   * Accepted by the owner (2026-10-10). Comments live on post pages and post
   * pages carry ads, so the only alternatives were dropping ads or comments.
   * The stored value is giscus's server-encrypted session, usable only
   * through giscus.app to comment or react as that reader in this repo's
   * Discussions; abusing it requires compromised AdSense code. Revisit if
   * giscus changes what the session grants or ads leave post pages.
   */
  function takeSession(): string {
    const url = new URL(location.href);
    if (url.searchParams.has('giscus')) {
      const fromUrl = url.searchParams.get('giscus');
      // Always take the parameter out of the address bar, valid or not.
      url.searchParams.delete('giscus');
      // Keep history.state: Astro's router stores its own data there.
      history.replaceState(history.state, '', url.toString());
      if (isSession(fromUrl)) {
        try {
          localStorage.setItem(SESSION_KEY, JSON.stringify(fromUrl));
        } catch {
          // Not persisted; the session still works for this page view.
        }
        return fromUrl;
      }
    }
    // Handed over by the pre-ads scrubber in BaseLayout when storage is blocked.
    const handedOver: unknown = (window as { __giscusSession?: unknown }).__giscusSession;
    if (isSession(handedOver)) return handedOver;
    try {
      const saved = localStorage.getItem(SESSION_KEY);
      if (!saved) return '';
      const value: unknown = JSON.parse(saved);
      if (isSession(value)) return value;
    } catch {
      // Fall through: unreadable value.
    }
    forgetSession();
    return '';
  }

  /**
   * The page's path as the canonical link states it. location.pathname is not
   * stable: in-site links (ClientRouter) arrive without the trailing slash,
   * a direct visit gets GitHub Pages' slash redirect — and the thread key would
   * differ between the two, splitting one post's comments into two threads.
   */
  function canonicalPath(siteOrigin: string | undefined): string {
    const href = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href;
    if (href) {
      const canonical = new URL(href);
      // Only trust a canonical on this site: one pointing elsewhere (e.g. a
      // cross-post) must not decide this page's thread or login return URL.
      if (canonical.origin === siteOrigin || canonical.origin === location.origin) {
        return canonical.pathname;
      }
    }
    const { pathname } = location;
    return pathname.endsWith('/') ? pathname : `${pathname}/`;
  }

  /** Thread key, derived the way client.js does for mapping="pathname". */
  function pathnameTerm(path: string): string {
    return path.length < 2 ? 'index' : path.substring(1).replace(/\.\w+$/, '');
  }

  function widgetSrc(wrapper: HTMLElement, session: string, theme: string): string {
    const d = wrapper.dataset;
    // Send giscus only scheme://host/path: it uses this for the origin check,
    // the post-login return URL and the default backlink. Query strings and
    // anchors are nobody's business there.
    const path = canonicalPath(d.giscusSite);
    const pageUrl = `${location.origin}${path}`;
    const params = new URLSearchParams({
      origin: pageUrl,
      session,
      theme,
      ...FIXED_PARAMS,
      repo: d.giscusRepo ?? '',
      repoId: d.giscusRepoId ?? '',
      category: d.giscusCategory ?? '',
      categoryId: d.giscusCategoryId ?? '',
      description: metaContent("meta[property='og:description'],meta[name='description']"),
      backLink: metaContent("meta[name='giscus:backlink']") || pageUrl,
      term: pathnameTerm(path),
    });
    if (!session) params.delete('session');
    const locale = d.giscusLang ? `/${d.giscusLang}` : '';
    return `${GISCUS_ORIGIN}${locale}/widget?${params}`;
  }

  function mount(wrapper: HTMLElement): () => void {
    const container = wrapper.querySelector<HTMLElement>('.giscus');
    if (!container) return () => {};

    let session = takeSession();
    // The theme the widget was last told about (via src or setConfig), and
    // whether the current widget document is up — messages before that are
    // lost. `loaded` gates it: after a reload, late messages from the old
    // document (same contentWindow) must not mark the new one ready.
    let widgetTheme = currentTheme();
    let loaded = false;
    let widgetReady = false;
    const iframe = document.createElement('iframe');
    iframe.className = 'giscus-frame giscus-frame--loading';
    iframe.title = wrapper.dataset.giscusTitle || 'Comments';
    iframe.setAttribute('scrolling', 'no');
    iframe.allow = 'clipboard-write';
    iframe.src = widgetSrc(wrapper, session, widgetTheme);
    iframe.addEventListener('load', () => {
      loaded = true;
      iframe.classList.remove('giscus-frame--loading');
    });
    container.replaceChildren(iframe);

    const reloadSignedOut = () => {
      forgetSession();
      session = '';
      loaded = false;
      widgetReady = false;
      widgetTheme = currentTheme();
      iframe.src = widgetSrc(wrapper, '', widgetTheme);
    };

    const syncTheme = () => {
      if (!widgetReady) return; // src carries the theme; resynced once ready
      const next = currentTheme();
      if (next === widgetTheme) return;
      widgetTheme = next;
      iframe.contentWindow?.postMessage({ giscus: { setConfig: { theme: next } } }, GISCUS_ORIGIN);
    };

    const onMessage = (event: MessageEvent) => {
      if (event.origin !== GISCUS_ORIGIN || event.source !== iframe.contentWindow) return;
      const msg = (event.data as { giscus?: Record<string, unknown> } | null)?.giscus;
      if (!msg || typeof msg !== 'object') return;

      // The widget is up and listening now; catch up on any theme toggle that
      // happened while it was loading.
      if (loaded) {
        widgetReady = true;
        syncTheme();
      }

      const height = msg.resizeHeight;
      if (typeof height === 'number' && height > 0 && height <= MAX_FRAME_HEIGHT) {
        iframe.style.height = `${Math.ceil(height)}px`;
      }

      if (msg.signOut) {
        reloadSignedOut();
        return;
      }

      const error = typeof msg.error === 'string' ? msg.error : '';
      if (!error) return;
      if (/Bad credentials|Invalid state value|State has expired/.test(error)) {
        // Expired or revoked session: drop it and show the signed-out widget.
        if (session) reloadSignedOut();
      } else if (!error.includes('Discussion not found')) {
        // "Discussion not found" is normal until the first comment.
        console.warn(`[giscus] ${error}`);
      }
    };
    window.addEventListener('message', onMessage);

    // Follow the site theme toggle. <html> class changes for other reasons
    // too; syncTheme only messages the widget when the theme actually changed.
    const themeObserver = new MutationObserver(syncTheme);
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    return () => {
      window.removeEventListener('message', onMessage);
      themeObserver.disconnect();
    };
  }

  onPageLoad(() => {
    const wrapper = document.querySelector<HTMLElement>('.giscus-wrapper');
    if (!wrapper) return;

    if (!wrapper.dataset.giscusRepoId || !wrapper.dataset.giscusCategoryId) {
      wrapper.querySelector('.giscus-error')?.classList.remove('hidden');
      return;
    }

    let unmount: (() => void) | null = null;
    const start = () => {
      if (!unmount) unmount = mount(wrapper);
    };

    // Load when the comments come near the viewport (PRELOAD_MARGIN) rather
    // than on every page view. A login return (?giscus=) loads at once so the
    // session is taken out of the URL immediately.
    let visibility: IntersectionObserver | null = null;
    if (new URLSearchParams(location.search).has('giscus') || !('IntersectionObserver' in window)) {
      start();
    } else {
      visibility = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          visibility?.disconnect();
          visibility = null;
          start();
        },
        { rootMargin: PRELOAD_MARGIN },
      );
      visibility.observe(wrapper);
    }

    return () => {
      visibility?.disconnect();
      unmount?.();
    };
  });
</script>
