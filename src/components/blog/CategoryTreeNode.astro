---
import { getPostUrl } from '../../lib/utils';
export interface CategoryTreeNodeData {
  id: string;
  name: string;
  count: number;
  isActive: boolean;
  initiallyOpen: boolean;
  children: CategoryTreeNodeData[];
}

interface Props {
  node: CategoryTreeNodeData;
  depth?: number;
}

const { node, depth = 0 } = Astro.props;
const isNested = depth > 0;
// A node with nothing under it gets no disclosure control. The chevron is a
// promise that there is more below; on an empty branch it expands to nothing,
// which is the same dead affordance the empty category pages used to be.
const isLeaf = node.children.length === 0;
const rowClass = [
  'cat-row flex items-center gap-1 rounded-lg text-sm transition-colors',
  node.isActive
    ? 'text-[var(--color-accent)] font-medium shadow-[inset_2px_0_0_0_var(--color-accent)]'
    : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]',
];
const toggleClass = isNested
  ? 'cat-toggle flex items-center gap-1 py-1.5 pl-2 pr-1 rounded-l-xl cursor-pointer'
  : 'cat-toggle flex items-center gap-1 py-2 pl-2 pr-1 rounded-l-xl cursor-pointer';
const linkClass = isNested
  ? 'flex items-center justify-between flex-1 min-w-0 py-1.5 pr-2'
  : 'flex items-center justify-between flex-1 min-w-0 py-2 pr-2';
const childListClass = isNested
  ? 'ml-3 mt-1 space-y-0.5 border-l border-[color:color-mix(in_oklab,var(--color-border)_72%,transparent)] pl-2'
  : 'ml-3 mt-1 space-y-1 border-l border-[color:color-mix(in_oklab,var(--color-border)_72%,transparent)] pl-2';
---

{isLeaf ? (
  <div class:list={rowClass}>
    {/* Same width as the chevron button, so leaf and branch names line up. */}
    <span class={toggleClass} aria-hidden="true"><span class="w-3 h-3 shrink-0 block"></span></span>
    <a href={getPostUrl(node)} data-astro-prefetch="viewport" class={linkClass}>
      <span class="truncate">{node.name}</span>
      {node.count > 0 && <span class="text-xs text-[var(--color-text-muted)] ml-2 shrink-0">{node.count}</span>}
    </a>
  </div>
) : (
<details class="cat-tree" data-category={node.id} open={node.initiallyOpen}>
  <summary class:list={rowClass}>
    <button
      type="button"
      class={toggleClass}
      aria-expanded={node.initiallyOpen ? 'true' : 'false'}
    >
      <svg class="chevron w-3 h-3 shrink-0 text-[var(--color-text-muted)] transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <a href={getPostUrl(node)} data-astro-prefetch="viewport" class={linkClass}>
      <span class="truncate">{node.name}</span>
      {node.count > 0 && <span class="text-xs text-[var(--color-text-muted)] ml-2 shrink-0">{node.count}</span>}
    </a>
  </summary>

  {node.children.length > 0 && (
    <ul class={childListClass}>
      {node.children.map((child) => (
        <li>
          <Astro.self node={child} depth={depth + 1} />
        </li>
      ))}
    </ul>
  )}

</details>
)}
