---
import PostCard from '../blog/PostCard.astro';
import type { TopicHubDefinition } from '../../lib/content/hubs';
import type { TopicHubQuery } from '../../lib/content/curation';

interface Props {
  hub: TopicHubDefinition;
  query: TopicHubQuery;
  relatedHubs: readonly TopicHubDefinition[];
}

const { hub, query, relatedHubs } = Astro.props;
const startHere = query.startHere.map((document) => document.source);
const featured = query.featured.slice(0, 6).map((document) => document.source);
const recentlyUpdated = query.recentlyUpdated.slice(0, 6).map((document) => document.source);
---

<section class="py-16 border-b border-[var(--color-border)]">
  <div class="container max-w-5xl">
    <div class="section-eyebrow mb-3">Topic Hub</div>
    <h1 class="text-4xl font-bold mb-4">{hub.label}</h1>
    <p class="text-xl leading-relaxed text-[var(--color-text-secondary)] max-w-3xl">{hub.summary}</p>
    <p class="text-sm text-[var(--color-text-muted)] mt-4">대상: {hub.audience}</p>
  </div>
</section>

<div class="container max-w-5xl py-12 space-y-14">
  <section>
    <h2 class="text-2xl font-bold mb-3">Start Here</h2>
    <p class="text-[var(--color-text-secondary)] mb-6">처음 읽을 문서, 구조를 이해할 문서, 실전으로 들어갈 문서를 최대 세 개로 제안합니다.</p>
    <div class="grid gap-5 md:grid-cols-3">
      {startHere.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section>
    <h2 class="text-2xl font-bold mb-6">Core Concepts</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {hub.concepts.map((concept) => (
        <article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-secondary)] p-5">
          <h3 class="font-semibold">{concept.title}</h3>
          <p class="text-sm text-[var(--color-text-secondary)] mt-2">{concept.description}</p>
        </article>
      ))}
    </div>
  </section>

  {featured.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold mb-6">Featured Guides</h2>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}

  {relatedHubs.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold mb-4">Related Topics</h2>
      <div class="flex flex-wrap gap-3">
        {relatedHubs.map((related) => (
          <a class="btn btn-ghost border border-[var(--color-border)] rounded-xl" href={related.href}>{related.label}</a>
        ))}
      </div>
    </section>
  )}

  {recentlyUpdated.length > 0 && (
    <section>
      <h2 class="text-2xl font-bold mb-6">Recently Updated</h2>
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {recentlyUpdated.map((post) => <PostCard post={post} />)}
      </div>
    </section>
  )}
</div>
