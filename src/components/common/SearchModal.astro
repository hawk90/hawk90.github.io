---
import { t } from '../../consts/ui-strings';

const searchPlaceholder = t('search_placeholder');
const searchClose = t('search_close');
const searchSelect = t('search_select');
const searchNavigate = t('search_navigate');
const searchEmpty = t('search_empty');
const searchNoResults = t('search_no_results');
const searchLoading = t('search_loading');
const searchError = t('search_error');
const searchResultsCount = t('search_results_count');
const filterTagLabel = t('search_filter_tag');
const filterSeriesLabel = t('search_filter_series');
---

<div
  id="search-modal"
  class="search-modal fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-title"
  data-i18n-empty={searchEmpty}
  data-i18n-no-results={searchNoResults}
  data-i18n-loading={searchLoading}
  data-i18n-error={searchError}
  data-i18n-results-count={searchResultsCount}
  data-i18n-filter-tag={filterTagLabel}
  data-i18n-filter-series={filterSeriesLabel}
>
  <!-- Backdrop -->
  <div class="search-modal-backdrop absolute inset-0 bg-black/72" data-search-backdrop></div>

  <!-- Modal -->
  <div class="relative flex items-start justify-center pt-[12vh] px-4">
    <div class="search-modal-panel w-full max-w-2xl bg-[var(--color-bg-primary)] border border-[var(--color-border)] rounded-2xl shadow-2xl overflow-hidden">
      <!-- Filter -->
      <div id="filter-container" class="hidden px-4 py-2 border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]">
        <div class="flex items-center gap-2">
          <span id="filter-label" class="text-sm text-[var(--color-text-muted)]"></span>
          <button
            id="filter-badge"
            type="button"
            class="inline-flex items-center gap-1 px-2 py-1 text-sm bg-[var(--color-accent)] text-white rounded-full hover:bg-[var(--color-accent-hover)] transition-colors"
            aria-label="Clear filter"
          >
            <span id="filter-name"></span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Search Input -->
      <div class="flex items-center gap-3 px-4 border-b border-[var(--color-border)]">
        <svg class="w-5 h-5 text-[var(--color-text-muted)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="search-input"
          data-search-input
          placeholder={searchPlaceholder}
          class="flex-1 py-4 bg-transparent text-lg outline-none focus:outline-none placeholder:text-[var(--color-text-muted)]"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="search-results"
        />
        <button
          id="search-close-btn"
          class="p-2 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-bg-tertiary)] rounded-lg transition-colors"
          aria-label={searchClose}
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Results -->
      <div id="search-results" class="max-h-[60vh] overflow-y-auto" role="listbox" aria-label="Search results">
        <div class="p-10 text-center text-[var(--color-text-muted)]" data-search-empty>
          <svg class="w-8 h-8 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          {searchEmpty}
        </div>
      </div>

      <!-- Keyboard hints -->
      <div class="px-4 py-2.5 border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-xs text-[var(--color-text-muted)] flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-4">
          <span class="inline-flex items-center gap-1.5">
            <kbd class="px-1.5 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] font-mono text-[11px]">↑</kbd>
            <kbd class="px-1.5 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] font-mono text-[11px]">↓</kbd>
            {searchNavigate}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <kbd class="px-1.5 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] font-mono text-[11px]">↵</kbd>
            {searchSelect}
          </span>
        </div>
        <span class="inline-flex items-center gap-1.5">
          <kbd class="px-1.5 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] font-mono text-[11px]">esc</kbd>
          {searchClose}
        </span>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .search-modal {
    transition: opacity 160ms ease-out;
  }
  .search-modal.hidden { display: none; }
  .search-modal-panel {
    transform-origin: top center;
    animation: searchPanelIn 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes searchPanelIn {
    from { opacity: 0; transform: translateY(-8px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0)    scale(1); }
  }
  .search-modal-backdrop {
    animation: searchBackdropIn 160ms ease-out;
  }
  @keyframes searchBackdropIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  #search-input:focus { box-shadow: none; }
  #search-input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    box-shadow: none;
  }
  /* Result row hover/selected — left border accent + slightly stronger bg */
  #search-results a[role="option"] {
    border-left: 3px solid transparent;
    padding-left: calc(1rem - 3px);
    transition: background-color 120ms, border-color 120ms;
  }
  #search-results a[role="option"][aria-selected="true"],
  #search-results a[role="option"]:hover,
  #search-results a[role="option"]:focus {
    border-left-color: var(--color-accent);
    background-color: var(--color-bg-secondary);
  }
  #search-results .search-context {
    font-size: 11px;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .search-modal-panel, .search-modal-backdrop { animation: none; }
  }
</style>

<script>
  import { searchPosts, type SearchItem } from '../../lib/search';
  import { isInputElement } from '../../lib/keyboard';
  import { onPageLoad } from '../../lib/lifecycle';

  let searchIndex: SearchItem[] = [];
  let isLoaded = false;
  let loadPromise: Promise<boolean> | null = null;
  let loadRetries = 0;
  let currentFilter: { type: 'tag' | 'series'; value: string } | null = null;
  let selectedIndex = -1;

  const MAX_RETRIES = 3;

  function getI18n() {
    const modal = document.getElementById('search-modal');
    const d = modal?.dataset || {};
    return {
      emptyMessage: d.i18nEmpty || 'Type to search',
      noResultsMessage: d.i18nNoResults || 'No results',
      loadingMessage: d.i18nLoading || 'Loading...',
      errorMessage: d.i18nError || 'Error loading search',
      resultsCount: d.i18nResultsCount || ' results',
      filterTag: d.i18nFilterTag || 'Tag:',
      filterSeries: d.i18nFilterSeries || 'Series:',
    };
  }

  async function loadSearchIndex(): Promise<boolean> {
    if (isLoaded) return true;
    if (loadRetries >= MAX_RETRIES) return false;
    if (loadPromise) return loadPromise;

    loadPromise = (async () => {
      try {
        const res = await fetch('/search.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        searchIndex = await res.json();
        isLoaded = true;
        loadRetries = 0;
        return true;
      } catch (e) {
        loadRetries++;
        console.error(`Failed to load search index (attempt ${loadRetries}/${MAX_RETRIES}):`, e);
        return false;
      } finally {
        loadPromise = null;
      }
    })();

    return loadPromise;
  }

  onPageLoad(() => {
    const modalEl = document.getElementById('search-modal');
    const inputEl = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsEl = document.getElementById('search-results');
    if (!modalEl || !inputEl || !resultsEl) return;

    // After the guard above, these are non-null for the rest of init.
    const modal = modalEl as HTMLElement;
    const input = inputEl;
    const results = resultsEl as HTMLElement;
    const backdrop = document.querySelector('[data-search-backdrop]');
    const triggers = document.querySelectorAll('[data-search-trigger]');
    const filterContainer = document.getElementById('filter-container');
    const filterLabel = document.getElementById('filter-label');
    const filterName = document.getElementById('filter-name');
    const filterBadge = document.getElementById('filter-badge');
    const closeBtn = document.getElementById('search-close-btn');

    const i18n = getI18n();
    const preloadSearch = () => {
      void loadSearchIndex();
    };

    let openerElement: HTMLElement | null = null;

    function showMessage(message: string, loading = false) {
      const messageEl = document.createElement('div');
      messageEl.className = 'p-8 text-center text-[var(--color-text-muted)]';
      if (loading) {
        const spinner = document.createElement('span');
        spinner.className = 'animate-spin inline-block w-5 h-5 mr-2 align-middle rounded-full border-2 border-current border-r-transparent';
        spinner.setAttribute('aria-hidden', 'true');
        messageEl.append(spinner);
      }
      messageEl.append(message);
      results.replaceChildren(messageEl);
    }

    function setFilter(filter: { type: 'tag' | 'series'; value: string } | null) {
      currentFilter = filter;
      if (filter && filterContainer && filterLabel && filterName) {
        filterContainer.classList.remove('hidden');
        filterLabel.textContent = filter.type === 'tag' ? i18n.filterTag : i18n.filterSeries;
        filterName.textContent = filter.value;
      } else if (filterContainer) {
        filterContainer.classList.add('hidden');
      }
    }

    function openModal(filter?: { type: 'tag' | 'series'; value: string }) {
      openerElement = document.activeElement as HTMLElement;
      setFilter(filter || null);
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      input.focus();
      input.setAttribute('aria-expanded', 'true');
      selectedIndex = -1;
      showMessage(i18n.loadingMessage, true);

      loadSearchIndex().then((success) => {
        if (success) {
          renderResults(input.value || '');
        } else {
          showMessage(i18n.errorMessage);
        }
      });
    }

    function closeModal() {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
      input.value = '';
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      setFilter(null);
      selectedIndex = -1;
      showMessage(i18n.emptyMessage);

      if (openerElement) {
        openerElement.focus();
      } else {
        const trigger = document.querySelector('[data-search-trigger]') as HTMLElement;
        trigger?.focus();
      }
    }

    function updateSelection(newIndex: number) {
      const items = results.querySelectorAll('a[role="option"]');
      if (items.length === 0) return;

      if (newIndex < 0) newIndex = items.length - 1;
      if (newIndex >= items.length) newIndex = 0;

      // Only use aria-selected for styling (CSS handles the highlight)
      items.forEach((item) => {
        item.setAttribute('aria-selected', 'false');
      });

      selectedIndex = newIndex;
      const selected = items[selectedIndex] as HTMLElement;
      selected.setAttribute('aria-selected', 'true');
      selected.scrollIntoView({ block: 'nearest' });

      input.setAttribute('aria-activedescendant', selected.id);
    }

    function selectCurrent() {
      const items = results.querySelectorAll('a[role="option"]');
      if (selectedIndex >= 0 && selectedIndex < items.length) {
        (items[selectedIndex] as HTMLAnchorElement).click();
      }
    }

    function renderResults(query: string) {
      const q = query.trim();
      selectedIndex = -1;
      input.removeAttribute('aria-activedescendant');

      if (!q && currentFilter) {
        const options = currentFilter.type === 'tag'
          ? { filterTag: currentFilter.value }
          : { filterSeries: currentFilter.value };
        const matches = searchPosts(searchIndex, options);
        if (matches.length === 0) showMessage(i18n.noResultsMessage);
        else renderMatchList(matches, '');
        return;
      }

      if (!q) {
        showMessage(i18n.emptyMessage);
        return;
      }

      const options: { query: string; filterTag?: string; filterSeries?: string } = { query: q };
      if (currentFilter) {
        if (currentFilter.type === 'tag') options.filterTag = currentFilter.value;
        else options.filterSeries = currentFilter.value;
      }

      const matches = searchPosts(searchIndex, options);
      if (matches.length === 0) showMessage(i18n.noResultsMessage);
      else renderMatchList(matches, q);
    }

    function renderMatchList(matches: SearchItem[], query: string) {
      const count = document.createElement('div');
      count.className = 'px-4 py-2 text-[11px] text-[var(--color-text-muted)] uppercase tracking-wider border-b border-[var(--color-border)] bg-[var(--color-bg-secondary)]/40';
      count.textContent = `${matches.length}${i18n.resultsCount}`;
      // When already filtering by series, the series context on each row is redundant.
      const showContext = currentFilter?.type !== 'series';
      const items = matches.map((item, index) => createResultItem(item, index, query, showContext));
      results.replaceChildren(count, ...items);
    }

    function createResultItem(item: SearchItem, index: number, query: string, showContext: boolean): HTMLAnchorElement {
      const link = document.createElement('a');
      link.href = `/blog/${encodeURI(item.slug)}`;
      link.id = `search-opt-${index}`;
      link.setAttribute('role', 'option');
      link.setAttribute('aria-selected', 'false');
      link.className = 'block px-4 py-3 border-b border-[var(--color-border)] last:border-0 outline-none';
      if (showContext && item.series) {
        const context = document.createElement('div');
        context.className = 'search-context';
        context.textContent = item.series;
        link.append(context);
      }
      const title = document.createElement('div');
      title.className = 'font-medium';
      appendHighlightedText(title, item.title, query);
      link.append(title);
      if (item.description) {
        const description = document.createElement('div');
        description.className = 'text-sm text-[var(--color-text-secondary)] line-clamp-2 mt-0.5';
        appendHighlightedText(description, item.description, query);
        link.append(description);
      }
      if (item.tags.length > 0) {
        const tags = document.createElement('div');
        tags.className = 'flex gap-1.5 mt-2 flex-wrap';
        for (const tag of item.tags.slice(0, 3)) {
          const tagEl = document.createElement('span');
          tagEl.className = 'text-[11px] px-2 py-0.5 bg-[var(--color-accent-muted)] text-[var(--color-accent)] rounded-full';
          tagEl.textContent = tag;
          tags.append(tagEl);
        }
        link.append(tags);
      }
      return link;
    }

    function appendHighlightedText(container: HTMLElement, text: string, query: string) {
      const normalizedQuery = query.trim();
      if (!normalizedQuery) {
        container.textContent = text;
        return;
      }
      const matcher = new RegExp(`(${normalizedQuery.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      const lowerQuery = normalizedQuery.toLowerCase();
      for (const part of text.split(matcher)) {
        if (part.toLowerCase() === lowerQuery) {
          const mark = document.createElement('mark');
          mark.className = 'bg-[var(--color-accent-muted)] text-[var(--color-accent)] px-0.5 rounded';
          mark.textContent = part;
          container.append(mark);
        } else {
          container.append(part);
        }
      }
    }

    // Event handlers
    function handleFilterBadgeClick() {
      setFilter(null);
      renderResults(input.value || '');
      input.focus();
    }

    function handleTriggerClick(e: Event) {
      e.preventDefault();
      openModal();
    }

    function handleBackdropClick() {
      closeModal();
    }

    function handleKeydown(e: KeyboardEvent) {
      if (e.key === '/' && modal.classList.contains('hidden')) {
        if (!isInputElement(e.target)) {
          e.preventDefault();
          openModal();
        }
        return;
      }

      if (modal.classList.contains('hidden')) return;

      const items = results.querySelectorAll('a[role="option"]');

      switch (e.key) {
        case 'Escape':
          closeModal();
          break;
        case 'ArrowDown':
          e.preventDefault();
          updateSelection(selectedIndex + 1);
          break;
        case 'ArrowUp':
          e.preventDefault();
          updateSelection(selectedIndex - 1);
          break;
        case 'Enter':
          if (selectedIndex >= 0) {
            e.preventDefault();
            selectCurrent();
          }
          break;
        case 'Tab':
          const focusableEls = [input, closeBtn, ...Array.from(items)].filter(Boolean) as HTMLElement[];
          const currentIdx = focusableEls.indexOf(document.activeElement as HTMLElement);
          
          if (e.shiftKey) {
            if (currentIdx <= 0) {
              e.preventDefault();
              focusableEls[focusableEls.length - 1].focus();
            }
          } else {
            if (currentIdx >= focusableEls.length - 1 || currentIdx === -1) {
              e.preventDefault();
              focusableEls[0].focus();
            }
          }
          break;
      }
    }

    function handleInput(e: Event) {
      renderResults((e.target as HTMLInputElement).value);
    }

    function handleDocumentClick(e: MouseEvent) {
      const target = e.target as HTMLElement;

      const tagTrigger = target.closest('[data-search-tag]');
      if (tagTrigger) {
        e.preventDefault();
        const tag = tagTrigger.getAttribute('data-search-tag');
        if (tag) openModal({ type: 'tag', value: tag });
        return;
      }

      const seriesTrigger = target.closest('[data-search-series]');
      if (seriesTrigger) {
        e.preventDefault();
        const series = seriesTrigger.getAttribute('data-search-series');
        if (series) openModal({ type: 'series', value: series });
      }
    }

    // Attach listeners
    filterBadge?.addEventListener('click', handleFilterBadgeClick);
    triggers.forEach((trigger) => {
      trigger.addEventListener('click', handleTriggerClick);
      trigger.addEventListener('pointerenter', preloadSearch, { once: true });
      trigger.addEventListener('focus', preloadSearch, { once: true });
    });
    backdrop?.addEventListener('click', handleBackdropClick);
    closeBtn?.addEventListener('click', handleBackdropClick);
    document.addEventListener('keydown', handleKeydown);
    input.addEventListener('input', handleInput);
    document.addEventListener('click', handleDocumentClick);
    const idleLoader = window.setTimeout(preloadSearch, 1200);

    return () => {
      filterBadge?.removeEventListener('click', handleFilterBadgeClick);
      triggers.forEach((trigger) => {
        trigger.removeEventListener('click', handleTriggerClick);
        trigger.removeEventListener('pointerenter', preloadSearch);
        trigger.removeEventListener('focus', preloadSearch);
      });
      backdrop?.removeEventListener('click', handleBackdropClick);
      closeBtn?.removeEventListener('click', handleBackdropClick);
      document.removeEventListener('keydown', handleKeydown);
      input.removeEventListener('input', handleInput);
      document.removeEventListener('click', handleDocumentClick);
      window.clearTimeout(idleLoader);
    };
  });
</script>
