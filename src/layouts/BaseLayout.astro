---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import ScrollProgress from '../components/ui/ScrollProgress.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import SearchModal from '../components/common/SearchModal.astro';
import { SITE_CONFIG, ANALYTICS_CONFIG, COMMENTS_CONFIG, ADS_CONFIG } from '../consts/config';
import { t } from '../consts/ui-strings';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  showProgress?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
  noIndex?: boolean;
  noFollow?: boolean;
  /** Keep Auto ads off utility, navigation, and policy pages. */
  noAds?: boolean;
  canonical?: string;
  hasMath?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = '/og-default.png',
  type = 'website',
  showProgress = false,
  publishedTime,
  modifiedTime,
  author = SITE_CONFIG.author,
  noIndex = false,
  noFollow = false,
  noAds = false,
  canonical,
  hasMath = false,
} = Astro.props;

const canonicalURL = canonical
  ? new URL(canonical)
  : new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const robotsValue = [noIndex && 'noindex', noFollow && 'nofollow']
  .filter(Boolean)
  .join(', ');
const ogLocale = SITE_CONFIG.locale.replace('-', '_');

// --- Ads and Content-Security-Policy -------------------------------------
// Ads run on content pages only. Admin (a GitHub token is typed there),
// settings, the component gallery and 404 stay ad-free under the strict CSP.
const pagePath = Astro.url.pathname;
// Whole path segments only: '/admin' covers '/admin' and '/admin/x', not
// '/administration'. '/404' is rendered as /404.html.
const adsOnPage =
  ADS_CONFIG.enabled &&
  !noAds &&
  !ADS_CONFIG.excludePaths.some(
    (prefix) => pagePath === prefix || pagePath === `${prefix}.html` || pagePath.startsWith(`${prefix}/`),
  );

const analyticsScriptOrigins =
  !ANALYTICS_CONFIG.enabled ? []
  : ANALYTICS_CONFIG.provider === 'google' ? ['https://www.googletagmanager.com', 'https://www.google-analytics.com']
  : ANALYTICS_CONFIG.provider === 'umami' ? [new URL(ANALYTICS_CONFIG.src || 'https://analytics.umami.is/script.js').origin]
  : ['https://plausible.io'];
const analyticsConnectOrigins =
  !ANALYTICS_CONFIG.enabled ? []
  : ANALYTICS_CONFIG.provider === 'google' ? ['https://www.google-analytics.com']
  : analyticsScriptOrigins;

/*
  Strict policy (no ads on this page). 'unsafe-inline' is only a pre-CSP2
  fallback: csp-inline-script-hashes.mjs adds the hash of every inline script
  at build time, and browsers that see a hash ignore 'unsafe-inline'. giscus
  runs no script here (see Giscus.astro); only its iframe loads. GitHub API
  origins are for the admin panel (raw.githubusercontent.com: the drafts list
  reads each file's frontmatter from there).
*/
const strictPolicy = [
  "default-src 'self'",
  ["script-src 'self' 'unsafe-inline'", ...analyticsScriptOrigins].join(' '),
  "style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net",
  "font-src 'self' https://cdn.jsdelivr.net",
  "img-src 'self' data: https:",
  ["connect-src 'self' https://api.github.com https://github.com https://raw.githubusercontent.com", ...analyticsConnectOrigins].join(' '),
  "frame-src https://giscus.app",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self' https://github.com",
].join('; ');

/*
  Ads policy. AdSense officially supports only a nonce-based strict CSP sent as
  an HTTP header (its ad domains change over time); GitHub Pages can send
  neither headers nor per-request nonces, so that is not available here. This
  is Google's documented directive set ("Integrate the AdSense ad code with a
  CSP") with the nonce and 'strict-dynamic' removed — not a policy Google
  endorses as such. data: is allowed because under 'strict-dynamic' Google's
  policy would let ad code load data: scripts; it adds nothing beyond
  'unsafe-inline'. No fetch/frame/img restrictions: creatives load from
  arbitrary hosts and Google warns stricter policies may break without notice.
  Marked data-csp-ads so the build does not pin hashes (a hash would make
  browsers ignore 'unsafe-inline' and block ad code).
*/
const adsPolicy = [
  "script-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self' https://github.com",
].join('; ');

// JSON-LD structured data
const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImageURL.toString(),
      url: canonicalURL.toString(),
      datePublished: publishedTime?.toISOString(),
      dateModified: modifiedTime?.toISOString() || publishedTime?.toISOString(),
      author: {
        '@type': 'Person',
        name: author,
      },
      publisher: {
        '@type': 'Organization',
        name: SITE_CONFIG.title,
        url: SITE_CONFIG.url,
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_CONFIG.title,
      description: SITE_CONFIG.description,
      url: SITE_CONFIG.url,
    };
---

<!doctype html>
<html lang={SITE_CONFIG.lang} data-code-theme="github-dark-dimmed">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href={canonicalURL} />
    {COMMENTS_CONFIG.enabled && COMMENTS_CONFIG.provider === 'giscus' && (
      // giscus links new threads back to this URL instead of location.href,
      // which can carry ?utm=… or #anchor.
      <meta name="giscus:backlink" content={canonicalURL.toString()} />
    )}

    <!-- Security -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {adsOnPage
      ? <meta http-equiv="Content-Security-Policy" data-csp-ads content={adsPolicy} />
      : <meta http-equiv="Content-Security-Policy" content={strictPolicy} />}

    {/* AdSense site-ownership verification, on every page. The Auto ads script
        itself is near the end of <head>, after the critical CSS and font. */}
    <meta name="google-adsense-account" content={ADS_CONFIG.client} />
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {robotsValue && <meta name="robots" content={robotsValue} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={SITE_CONFIG.title} />
    <meta property="og:locale" content={ogLocale} />

    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- JSON-LD Structured Data (escape </ to prevent script breakout) -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

    <!-- Analytics -->
    {ANALYTICS_CONFIG.enabled && ANALYTICS_CONFIG.provider === 'google' && ANALYTICS_CONFIG.id && (
      <>
        <script is:inline async crossorigin="anonymous" src={`https://www.googletagmanager.com/gtag/js?id=${ANALYTICS_CONFIG.id}`}></script>
        <script is:inline data-ga-id={ANALYTICS_CONFIG.id}>
          window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag("js",new Date());gtag("config",document.currentScript.getAttribute("data-ga-id"));
        </script>
      </>
    )}
    {ANALYTICS_CONFIG.enabled && ANALYTICS_CONFIG.provider === 'umami' && ANALYTICS_CONFIG.id && (
      <script is:inline async defer crossorigin="anonymous" data-website-id={ANALYTICS_CONFIG.id} src={ANALYTICS_CONFIG.src || 'https://analytics.umami.is/script.js'}></script>
    )}
    {ANALYTICS_CONFIG.enabled && ANALYTICS_CONFIG.provider === 'plausible' && ANALYTICS_CONFIG.id && (
      <script is:inline async defer crossorigin="anonymous" data-domain={ANALYTICS_CONFIG.id} src="https://plausible.io/js/script.js"></script>
    )}

    {/* KaTeX CSS — only on pages with math content */}
    {hasMath && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.19.0/dist/katex.min.css"
        integrity="sha384-3rdsX6e5mueWyoweR9NIVmtEsUkokpBT/0ALqKKIBMr9j4qhHkaIkAcGgsE6uVlp"
        crossorigin="anonymous"
      />
    )}

    {/* Fonts — Pretendard via CDN dynamic subset (Korean unicode-range optimized).
        JetBrains Mono self-hosted (see /src/styles/global.css @font-face). */}
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    {/*
      SRI on the one third-party resource that is neither optional nor gated.
      AP-SEC-06/08/13 were accepted on the grounds that third-party code here
      is optional and the article renders without it — true of comments and
      analytics, not of this. It is render-blocking in the head of all 1478
      pages, so a compromised CDN response would be styling every one of them.

      The hash is over the decoded bytes, so it holds for the gzip and brotli
      variants alike. It is pinned to the @v1.3.9 tag; bump both together, and
      recompute with:
        curl -s --compressed <url> | openssl dgst -sha384 -binary | openssl base64 -A
      If the bytes ever stop matching, the browser drops the stylesheet and
      falls back to the system font stack — degraded, not broken.
    */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
      integrity="sha384-GIdEBaqGN9mNkDkMkzMHW8EKUqtpPIe/sLj1X7DIrnc9uPtLROJgmuDlh+3rBw0j"
      crossorigin="anonymous"
    />
    <link rel="preload" href="/fonts/JetBrainsMono-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- Clickjacking protection (frame-busting) -->
    <script is:inline>
      if(window.top!==window.self){window.top.location=window.self.location}
    </script>

    <!--
      Theme initialization — render-blocking to prevent FOUC.
      This inline IIFE intentionally duplicates the localStorage read +
      class/attribute write that `lib/theme.ts → applyTheme` does. The
      duplication is the price of pre-paint execution: we cannot import a
      module from an inline script. The two stay in sync via the
      VALID_CODE_THEMES constant and STORAGE_KEYS object that both sides
      consume — change the keys in one place only.
    -->
    <script is:inline>
      (function(){
        try{
          var V=["github-dark-dimmed","github-light","dracula","one-dark-pro","catppuccin-mocha","catppuccin-latte","nord","tokyo-night"];
          var el=document.documentElement, t=localStorage.getItem("theme");
          var pref=window.matchMedia&&window.matchMedia("(prefers-color-scheme: light)").matches;
          var light=t==="light"||(t!=="dark"&&pref);
          el.classList.toggle("light",light);
          var c=localStorage.getItem("code-theme"); if(V.indexOf(c)===-1) c="github-dark-dimmed";
          el.setAttribute("data-code-theme",c);
          var n=localStorage.getItem("show-line-numbers");
          el.setAttribute("data-show-line-numbers",n!=="false"?"true":"false");
          if(localStorage.getItem("reading-mode")==="1") el.classList.add("reading-mode");
          // Theme customizer pre-paint
          var f=localStorage.getItem("font-family");   if(f) el.setAttribute("data-font",f);
          var dn=localStorage.getItem("ui-density");   if(dn) el.setAttribute("data-density",dn);
          var ac=localStorage.getItem("accent-color"); if(ac) el.setAttribute("data-accent",ac);
        }catch(e){}
      })();
    </script>

    {/* SPA-style navigation, off while ads are enabled: a ClientRouter swap
        discards the <body> (and the Auto ads placed in it) without AdSense
        scanning the new page, so only the landing page would get ads; and a
        meta CSP stays in force across swaps, so the ads policy and ad code
        would carry into /admin. Full loads avoid both. Every astro:page-load
        listener here also runs its init directly, so nothing depends on it. */}
    {!ADS_CONFIG.enabled && <ClientRouter />}

    <!-- Reactive theme wiring (before-swap, after-swap, pageshow,
         astro:page-load, storage). All handlers live in lib/theme.ts. -->
    <script>
      import { installThemeReactivity, syncCodeTheme } from '../lib/theme';
      installThemeReactivity();
      syncCodeTheme();
    </script>
    {/* After a GitHub login giscus returns here with ?giscus=<session>, a
        1-year token. The comments loader moves it into storage, but it is a
        deferred module and adsbygoogle.js below is async, so the ad script can
        run first and report location.href with the token in it. This runs while
        the parser is still here, before any async script, and does the same
        move (format check = isSession() in Giscus.astro). If storage is
        blocked the token is handed over in a window property instead. */}
    {adsOnPage && COMMENTS_CONFIG.enabled && COMMENTS_CONFIG.provider === 'giscus' && (
      <script is:inline>{`(function(){try{var u=new URL(location.href);if(!u.searchParams.has('giscus'))return;var s=u.searchParams.get('giscus');u.searchParams.delete('giscus');history.replaceState(history.state,'',u.toString());if(!s||s.length>4096||!/^[0-9a-f]{24}[A-Za-z0-9+/]+={0,2}$/.test(s))return;try{localStorage.setItem('giscus-session',JSON.stringify(s));}catch(e){window.__giscusSession=s;}}catch(e){}})();`}</script>
    )}
    {/* AdSense Auto ads, only where ads run. Last in <head>, so the title, critical
        CSS and the font preload are requested first; async, and the layout
        reserves no ad slots, so a blocked or failing script changes nothing. */}
    {adsOnPage && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADS_CONFIG.client}`}
        crossorigin="anonymous"
      ></script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to content (accessibility) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-4 focus:py-2 focus:bg-[var(--color-accent)] focus:text-white focus:rounded-lg focus:text-sm focus:font-medium">
      {t('skip_to_content')}
    </a>
    {showProgress && <ScrollProgress />}
    <Header transition:persist="header" />
    <main id="main-content" class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <BackToTop />
    <SearchModal />

    <!-- Keyboard Shortcuts Help Modal -->
    <div id="shortcuts-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label={t('keyboard_shortcuts')}>
      <div class="absolute inset-0 bg-black/72" data-shortcuts-backdrop></div>
      <div class="relative flex items-center justify-center min-h-screen px-4">
        <div class="w-full max-w-sm bg-[var(--color-bg-primary)] border border-[var(--color-border)] rounded-xl shadow-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold">{t('keyboard_shortcuts')}</h2>
            <button type="button" data-shortcuts-close class="p-1 text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] rounded-lg" aria-label={t('search_close')}>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
          <dl class="space-y-3 text-sm">
            <div class="flex justify-between">
              <dt class="text-[var(--color-text-secondary)]">{t('shortcut_open_search')}</dt>
              <dd><kbd class="px-2 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] text-xs">/</kbd></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-[var(--color-text-secondary)]">{t('shortcut_help')}</dt>
              <dd><kbd class="px-2 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] text-xs">?</kbd></dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-[var(--color-text-secondary)]">{t('shortcut_close_modal')}</dt>
              <dd><kbd class="px-2 py-0.5 bg-[var(--color-bg-tertiary)] rounded border border-[var(--color-border)] text-xs">Esc</kbd></dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <!-- Keyboard shortcuts -->
    <script>
      let shortcutsCleanup: (() => void) | null = null;

      function initShortcuts() {
        shortcutsCleanup?.();

        const shortcutsModal = document.getElementById('shortcuts-modal');
        const shortcutsBackdrop = document.querySelector('[data-shortcuts-backdrop]');
        const shortcutsClose = document.querySelector('[data-shortcuts-close]');

        function closeShortcutsModal() {
          shortcutsModal?.classList.add('hidden');
          document.body.style.overflow = '';
        }

        function openShortcutsModal() {
          shortcutsModal?.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }

        function handleKeydown(e: KeyboardEvent) {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;

          if (e.key === 'Escape') {
            if (shortcutsModal && !shortcutsModal.classList.contains('hidden')) {
              closeShortcutsModal();
              return;
            }
            const activeElement = document.activeElement as HTMLElement;
            activeElement?.blur();
          }

          if (e.key === '?' && !e.ctrlKey && !e.metaKey) {
            if (shortcutsModal?.classList.contains('hidden')) {
              e.preventDefault();
              openShortcutsModal();
            }
          }
        }

        shortcutsBackdrop?.addEventListener('click', closeShortcutsModal);
        shortcutsClose?.addEventListener('click', closeShortcutsModal);
        document.addEventListener('keydown', handleKeydown);

        shortcutsCleanup = () => {
          shortcutsBackdrop?.removeEventListener('click', closeShortcutsModal);
          shortcutsClose?.removeEventListener('click', closeShortcutsModal);
          document.removeEventListener('keydown', handleKeydown);
        };
      }

      initShortcuts();
      document.addEventListener('astro:page-load', initShortcuts);
    </script>

    <!-- Image lightbox (click any <img> inside .prose to expand) -->
    <script>
      let lightboxCleanup: (() => void) | null = null;
      function initLightbox() {
        lightboxCleanup?.();
        const images = document.querySelectorAll<HTMLImageElement>('.prose img:not(.no-zoom)');
        if (images.length === 0) return;

        const overlay = document.createElement('div');
        overlay.className = 'lightbox-overlay';
        overlay.setAttribute('role', 'dialog');
        overlay.setAttribute('aria-modal', 'true');
        overlay.setAttribute('aria-label', 'Expanded image');
        overlay.dataset.open = 'false';
        overlay.style.display = 'none';
        const inner = document.createElement('img');
        inner.alt = '';
        overlay.appendChild(inner);
        document.body.appendChild(overlay);

        function close() {
          overlay.dataset.open = 'false';
          document.body.style.overflow = '';
          setTimeout(() => { overlay.style.display = 'none'; }, 200);
        }
        function open(src: string, alt: string) {
          inner.src = src;
          inner.alt = alt;
          overlay.style.display = 'flex';
          requestAnimationFrame(() => { overlay.dataset.open = 'true'; });
          document.body.style.overflow = 'hidden';
        }
        function onImgClick(e: Event) {
          const img = e.currentTarget as HTMLImageElement;
          open(img.currentSrc || img.src, img.alt);
        }
        function onKey(e: KeyboardEvent) {
          if (e.key === 'Escape' && overlay.dataset.open === 'true') close();
        }
        images.forEach((img) => img.addEventListener('click', onImgClick));
        overlay.addEventListener('click', close);
        document.addEventListener('keydown', onKey);

        lightboxCleanup = () => {
          images.forEach((img) => img.removeEventListener('click', onImgClick));
          overlay.removeEventListener('click', close);
          document.removeEventListener('keydown', onKey);
          overlay.remove();
        };
      }
      initLightbox();
      document.addEventListener('astro:page-load', initLightbox);
    </script>
  </body>
</html>
