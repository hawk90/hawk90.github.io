---
/*
 * Compatibility shim for the old public Series URLs.
 * Series is still metadata and powers previous/next navigation, but it is no
 * longer a standalone browse surface. Keep old inbound links recoverable while
 * sending readers back to the blog index.
 */
import { getPublishedPosts, getAllSeries } from '../../lib/posts';
import { toSlug } from '../../lib/utils';

export async function getStaticPaths() {
  const series = getAllSeries(await getPublishedPosts());
  return series.map((name) => ({ params: { series: toSlug(name) } }));
}

const destination = '/blog';
---
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>블로그로 이동합니다</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destination} />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
  </head>
  <body>
    <p>시리즈 페이지가 블로그로 통합되었습니다. <a href={destination}>블로그로 이동</a></p>
  </body>
</html>
