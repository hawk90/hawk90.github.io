---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostRow from '../../../components/blog/PostRow.astro';
import BlogSidebar from '../../../components/blog/BlogSidebar.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import { CATEGORIES, getCategoryById } from '../../../consts/categories';
import { getPublishedPosts, filterByCategory } from '../../../lib/posts';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  // A category with nothing published is a publishing plan, not a page. Built
  // anyway, 54 of the 65 entries became pages whose only content was "No posts
  // in this category yet." — each one linked from the sidebar of every page and
  // submitted in the sitemap, and the sidebar suppresses the count badge at
  // zero, so the emptiness was invisible until the click.
  //
  // Gating here rather than pruning `categories.ts` keeps the plan intact: the
  // drafts under those paths are real, and the page comes back on its own the
  // moment one of them publishes.
  const categoryPages = CATEGORIES
    .filter((cat) => filterByCategory(allPosts, cat.id).length > 0)
    .map((cat) => ({
      params: { category: cat.id },
      props: { categoryInfo: cat, allPosts },
    }));

  return categoryPages;
}

const { category } = Astro.params;
const { categoryInfo, allPosts } = Astro.props;

// Same leaf name under a different parent means an ambiguous title; qualify
// only those, so unique names keep their short form.
const sameName = categoryInfo ? CATEGORIES.filter((entry) => entry.name === categoryInfo.name) : [];
const parentName = categoryInfo?.parent ? getCategoryById(categoryInfo.parent)?.name : undefined;
const qualifiedName = sameName.length > 1 && parentName && categoryInfo
  ? `${categoryInfo!.name} (${parentName})`
  : categoryInfo?.name ?? '';
// Empty on a redirect entry, which leaves the listing below a no-op.
const categoryPosts = categoryInfo ? filterByCategory(allPosts, category!) : [];

type Post = (typeof categoryPosts)[number];

const seriesMap = new Map<string, Map<string, Post[]>>();
for (const post of categoryPosts) {
  const series = post.data.series ?? 'Other';
  const parts = post.id.split('/');
  // Slug is "category/series-slug/[chapter/]section". Depth ≥ 4 means a chapter exists.
  const chapter = parts.length >= 4 ? parts[2] : '_flat';
  if (!seriesMap.has(series)) seriesMap.set(series, new Map());
  const chapters = seriesMap.get(series)!;
  if (!chapters.has(chapter)) chapters.set(chapter, []);
  chapters.get(chapter)!.push(post);
}
for (const chapters of seriesMap.values()) {
  for (const posts of chapters.values()) {
    posts.sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  }
}
const seriesList = [...seriesMap.entries()]
  .map(([name, chapters]) => ({
    name,
    chapters: [...chapters.entries()]
      .map(([key, posts]) => ({ key, posts, label: formatChapter(key) }))
      .sort((a, b) => (a.posts[0]?.data.seriesOrder ?? 0) - (b.posts[0]?.data.seriesOrder ?? 0)),
  }))
  .sort(
    (a, b) =>
      (a.chapters[0]?.posts[0]?.data.seriesOrder ?? 0) -
      (b.chapters[0]?.posts[0]?.data.seriesOrder ?? 0),
  );

function formatChapter(key: string): string {
  if (key === '_flat') return '';
  const m = key.match(/^ch(\d+)(?:-(.+))?$/);
  if (!m) return key;
  const num = String(parseInt(m[1], 10)).padStart(2, '0');
  if (!m[2]) return `Chapter ${num}`;
  const title = m[2]
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
  return `Chapter ${num} · ${title}`;
}
---

/*
    Two category names repeat under different parents — Systems lives at both
    `systems` and `ml/systems`, Compilers at `programming/compilers` and
    `ml/compilers`. Unqualified, each pair renders the same title, so a crawler
    sees two pages claiming to be the same thing. The parent is what tells them
    apart, so it goes in the title whenever the name is not unique.
*/
<BaseLayout title={`${qualifiedName} - Blog`} description={categoryInfo!.description}>
  <section class="py-16 lg:py-24">
    <div class="container">
      <div class="lg:flex lg:gap-12">
        <!-- Main Content -->
        <div class="flex-1 min-w-0">
          <Breadcrumb items={[{ label: 'Blog', href: '/blog' }, { label: categoryInfo!.name }]} />

          <div class="mb-8">
            <h1 class="text-4xl font-bold mb-4">{categoryInfo!.name}</h1>
            <p class="text-lg text-[var(--color-text-secondary)]">
              {categoryInfo!.description}
            </p>
          </div>

          {/* No empty state: getStaticPaths only builds categories that have
              published posts, so this list is never empty. */}
          <div class="space-y-12">
            {seriesList.map((s) => (
                <div>
                  <h2 class="text-2xl font-bold mb-6 pb-2 border-b border-[var(--color-border)]">
                    {s.name}
                  </h2>
                  <div class="space-y-8">
                    {s.chapters.map((ch) => (
                      <div>
                        {ch.label && (
                          <h3 class="text-lg font-semibold mb-3 text-[var(--color-text-secondary)]">
                            {ch.label}
                          </h3>
                        )}
                        <div class="space-y-2.5">
                          {ch.posts.map((post) => (
                            <PostRow post={post} />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
            ))}
          </div>
        </div>

        <!-- Sidebar -->
        <BlogSidebar posts={allPosts} activeFilter={{ type: 'category', value: category! }} />
      </div>
    </div>
  </section>
</BaseLayout>
