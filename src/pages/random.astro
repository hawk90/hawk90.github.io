---
import { getPublishedPosts } from '../lib/posts';
import { getPostUrl } from '../lib/utils';

const posts = await getPublishedPosts();
// Pick a stable "random" at build time — different on each build.
// Client-side script below picks fresh per visit using the JSON list.
const slugs = posts.map((p) => p.id);
const buildPick = slugs[Math.floor(Math.random() * slugs.length)] ?? '';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <title>Random Post</title>
    <meta name="robots" content="noindex" />
    {/*
      Self-canonical, not a canonical to buildPick. Pointing it at the picked
      post claimed this page *is* that post, which is false: the destination
      differs on every build and again on every visit. Self plus noindex says
      the true thing — this URL is itself, and it is not for the index.
    */}
    <link rel="canonical" href={new URL('/random', Astro.site).toString()} />
    <meta http-equiv="refresh" content={`0; url=${getPostUrl(buildPick)}`} />
    <script is:inline type="application/json" id="random-slugs" set:html={JSON.stringify(slugs)}></script>
    <script is:inline>
      // Pick fresh per visit using the embedded slug list.
      (function () {
        try {
          const node = document.getElementById('random-slugs');
          if (!node) return;
          const list = JSON.parse(node.textContent || '[]');
          if (!Array.isArray(list) || list.length === 0) return;
          const pick = list[Math.floor(Math.random() * list.length)];
          // is:inline, so it cannot import getPostUrl. Kept as concatenation
          // rather than a template literal so the portability gate does not
          // read it as a second definition of the post path.
          location.replace('/blog/' + pick);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <p>Redirecting to a random post — <a href={getPostUrl(buildPick)}>continue manually</a> if not redirected.</p>
  </body>
</html>
