# build output
dist/
# generated types
.astro/
# pre-built OG images (generated by `npm run og`)
public/og/
public/og-default.png
# OG generator manifest
.cache/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# LaTeX build byproducts (diagram builds leave these behind)
*.aux
*.log
texput.log

# internal planning / storyboard docs (kept locally, not published)
/ARM_STORYBOARD.md
/QEMU_STORYBOARD.md
/RISCV_STORYBOARD.md
/INTERACTIVE_VISUALIZATIONS.md
/READING_ROADMAP.md
/docs/


# environment variables
.env
.env.*
.env.local
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# secrets / credentials
*.pem
*.key
credentials.json

# legacy backup (not part of Astro site)
_jekyll_backup/

# Book PDFs (book-notes book/ dirs) — safety net even though no PDFs go in repo
*.pdf
*.epub
*.djvu
scripts/__pycache__/

# Spec cache — 저작권 있는 spec 텍스트 추출 (CXL/PCIe/JEDEC 등). 로컬 참조용만.
data/*-spec-cache/

# Generated review-only audit output (regenerated locally from scripts)
node_modules/.package-lock.json
reports/content-readiness/series.txt
reports/content-readiness/staleness.txt
reports/diagrams/tikz-overlap-report.txt
